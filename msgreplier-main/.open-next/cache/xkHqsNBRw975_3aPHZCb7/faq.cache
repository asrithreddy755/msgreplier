d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"MsgReplier is a free, privacy-first platform for couples and individuals. It offers a suite of digital tools including Love-Space (a private real-time room for couples), Wishes Website (interactive digital greeting cards), FLAMES Calculator (a fun compatibility game), and AI Couple Prompts.\"}]]}],[\"$\",\"details\",\"gen-2\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is MsgReplier free to use?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Yes, all core features of MsgReplier are completely free to use. We are supported by non-intrusive advertisements via Google AdSense, which allows us to keep the platform free for everyone without requiring subscriptions or paid accounts.\"}]]}],[\"$\",\"details\",\"gen-3\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Do I need to create an account to use MsgReplier?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"No! MsgReplier is designed to be completely zero-friction. You do not need to register an account, provide an email address, or enter any personal details to use any of our tools. Simply visit the site and start using it immediately.\"}]]}],[\"$\",\"details\",\"gen-4\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is MsgReplier safe for teenagers?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"MsgReplier is designed for users aged 13 and above. Our tools are focused on fun, lighthearted couple activities. We do not collect personal data beyond what is strictly necessary for tool functionality, and all private room conversations are automatically deleted after periods of inactivity.\"}]]}]]}]]}],[\"$\",\"section\",\"Love-Space\",{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-[#110f0f] pb-2 border-b border-[#d4c3ab] font-heading\",\"children\":\"Love-Space\"}],[\"$\",\"div\",null,{\"className\":\"space-y-1\",\"children\":[[\"$\",\"details\",\"ls-1\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What is Love-Space?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Love-Space is a private, temporary digital room created exclusively for two people (typically a couple). It includes real-time chat, built-in games like Ludo and Tic Tac Toe, live presence indicators, and a warm, intimate interface designed to help couples stay connected.\"}]]}],[\"$\",\"details\",\"ls-2\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Is Love-Space truly private?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Yes. Love-Space rooms are private by design. Each room is accessed via a unique link or 5-digit code that only you and your partner have. No one else can join your room without the link. We do not read, monitor, or share your private conversations.\"}]]}],[\"$\",\"details\",\"ls-3\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How long does a Love-Space room last?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Love-Space rooms automatically expire after 24 hours from creation. Once a room closes, all associated chat data and game states are permanently deleted from our servers.\"}]]}],[\"$\",\"details\",\"ls-4\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What happens when my partner closes their tab?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"When one partner closes their browser tab or navigates away, the other partner will see a status indicator that they are offline. However, the room remains active and available for up to 24 hours after creation, allowing both partners to rejoin at any time.\"}]]}],[\"$\",\"details\",\"ls-5\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Can more than two people join a Love-Space room?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"No. Love-Space is intentionally designed for exactly two people. This ensures the space remains intimate, private, and focused on the connection between two partners. A room will not allow a third person to join once two members are already present.\"}]]}]]}]]}],[\"$\",\"section\",\"Wishes Website\",{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-[#110f0f] pb-2 border-b border-[#d4c3ab] font-heading\",\"children\":\"Wishes Website\"}],[\"$\",\"div\",null,{\"className\":\"space-y-1\",\"children\":[[\"$\",\"details\",\"ww-1\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What is the Wishes Website builder?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"The Wishes Website builder lets you create a beautiful, interactive, animated digital greeting page in seconds. You can personalise it with a recipient name, occasion (birthday, anniversary, etc.), a heartfelt message, a theme, music, and more — no design skills needed.\"}]]}],[\"$\",\"details\",\"ww-2\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How do I share my Wishes Website?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"After creating your Wishes Website, you will receive a unique shareable link. Simply copy this link and send it to your recipient via WhatsApp, Instagram DM, email, or any messaging app. When they open it, they will see your personalised interactive greeting.\"}]]}],[\"$\",\"details\",\"ww-3\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How long is my Wishes Website stored?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Wishes Website pages are stored for up to 12 months from creation or until you request deletion, whichever comes first. After this period, the page and all its content are automatically removed from our servers.\"}]]}]]}]]}],[\"$\",\"section\",\"Privacy & Data\",{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-[#110f0f] pb-2 border-b border-[#d4c3ab] font-heading\",\"children\":\"Privacy & Data\"}],[\"$\",\"div\",null,{\"className\":\"space-y-1\",\"children\":[[\"$\",\"details\",\"priv-1\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"What personal data does MsgReplier collect?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"We collect very minimal data. For most tools (FLAMES Calculator, AI Prompts), no data is collected at all — everything runs in your browser. For Love-Space, we temporarily store room metadata and chat history to enable real-time sync. For Wishes Website, we store the greeting content to generate a shareable link. We never collect your name, email, or phone number unless you contact us directly.\"}]]}],[\"$\",\"details\",\"priv-2\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does MsgReplier use cookies?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"We use strictly necessary cookies for essential functionality (like remembering your consent choice and theme preference). With your consent, we also use Google Analytics cookies (for anonymous traffic analysis) and Google AdSense cookies (for advertising). You can manage your cookie preferences at any time — see our Cookie Policy for details.\"}]]}],[\"$\",\"details\",\"priv-3\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"How can I request deletion of my data?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"You can request deletion of any data we hold about you by emailing us at care.msgreplier@gmail.com. For Love-Space, room data is automatically deleted when the room expires. For Wishes Website, include the unique link to your greeting page in your deletion request and we will remove it promptly.\"}]]}],[\"$\",\"details\",\"priv-4\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does MsgReplier sell my data?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"Absolutely not. We do not sell, rent, or trade any personal data to third parties. We use Google Analytics to understand site traffic (anonymised data) and Google AdSense to display ads. Both are governed by Google's privacy policy, which you can review at policies.google.com/privacy.\"}]]}]]}]]}],[\"$\",\"section\",\"Technical\",{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-[#110f0f] pb-2 border-b border-[#d4c3ab] font-heading\",\"children\":\"Technical\"}],[\"$\",\"div\",null,{\"className\":\"space-y-1\",\"children\":[[\"$\",\"details\",\"tech-1\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Which browsers does MsgReplier support?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-plus h-3.5 w-3.5\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"s699le\",{\"d\":\"M12 5v14\"}],\"$undefined\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\",\"children\":\"MsgReplier works on all modern browsers including Chrome, Firefox, Safari, Edge, and Opera. For the best Love-Space experience (especially for the real-time features), we recommend using the latest version of Chrome or Firefox on a stable internet connection.\"}]]}],[\"$\",\"details\",\"tech-2\",{\"className\":\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Does MsgReplier work on mobile phones?\"}],[\"$\",\"span\",null,{\"className\":\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\"