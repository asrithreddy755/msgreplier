border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-plus h-3.5 w-3.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1ays0h\\\",{\\\"d\\\":\\\"M5 12h14\\\"}],[\\\"$\\\",\\\"path\\\",\\\"s699le\\\",{\\\"d\\\":\\\"M12 5v14\\\"}],\\\"$undefined\\\"]}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-3 text-[#5d6c7b] text-sm md:text-base leading-relaxed pl-1\\\",\\\"children\\\":\\\"Love-Space is a private, temporary digital room created exclusively for two people (typically a couple). It includes real-time chat, built-in games like Ludo and Tic Tac Toe, live presence indicators, and a warm, intimate interface designed to help couples stay connected.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"ls-2\\\",{\\\"className\\\":\\\"group border-b border-[#d4c3ab]/30 py-4 cursor-pointer\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex items-center justify-between list-none font-bold text-sm md:text-base text-[#110f0f] focus:outline-none select-none py-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Is Love-Space truly private?\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"p-1 rounded-full border border-[#d4c3ab] transition-transform group-open:rotate-45 shrink-0 ml-4\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"str