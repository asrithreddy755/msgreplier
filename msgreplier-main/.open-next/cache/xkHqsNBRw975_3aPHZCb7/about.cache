{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"4294967294","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\"/><link rel=\"stylesheet\" href=\"/_next/static/css/76eb9e93ac3d3a04.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-95cc16016cdfb96f.js\"/><script src=\"/_next/static/chunks/4bd1b696-c9306982bc4992b6.js\" async=\"\"></script><script src=\"/_next/static/chunks/1684-187bd4b12caf3732.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-1d2908b81aa28bd8.js\" async=\"\"></script><script src=\"/_next/static/chunks/6874-43684eac73d02ae4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/about/page-cba4cd77af7c6c15.js\" async=\"\"></script><script src=\"/_next/static/chunks/668-3c9728cc03492410.js\" async=\"\"></script><script src=\"/_next/static/chunks/6671-a156e624aef6ad97.js\" async=\"\"></script><script src=\"/_next/static/chunks/8966-fe9c0b7581b40f7f.js\" async=\"\"></script><script src=\"/_next/static/chunks/8660-9547e3bd32179869.js\" async=\"\"></script><script src=\"/_next/static/chunks/7665-faac800d6f299277.js\" async=\"\"></script><script src=\"/_next/static/chunks/2323-91a8cccc686e3a27.js\" async=\"\"></script><script src=\"/_next/static/chunks/2707-553210aacc5228b8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-bf4362c50304bbf4.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-1XPYWEPPGJ\" as=\"script\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"icon\" href=\"/icon.png\" type=\"image/png\"/><link rel=\"shortcut icon\" href=\"/icon.png\"/><link rel=\"apple-touch-icon\" href=\"/icon.png\" sizes=\"180x180\"/><title>About Us - MsgReplier | Our Mission, Story &amp; Tools | MsgReplier</title><meta name=\"description\" content=\"Learn about MsgReplier — the free, privacy-first digital platform for couples. Discover our mission, the tools we build, and our commitment to keeping your data safe.\"/><meta name=\"keywords\" content=\"wishes website,private love space,couple chat room,birthday wishes website,anniversary wishes website,digital greeting card,couple games online\"/><link rel=\"canonical\" href=\"https://msgreplier.com/about\"/><meta property=\"og:title\" content=\"MsgReplier – Interactive Wishes &amp; Private Couple Spaces\"/><meta property=\"og:description\" content=\"Create a magical digital surprise with our wishes website builder or join your partner in a private Love-Space. Simple, fast, and unforgettable.\"/><meta property=\"og:url\" content=\"https://msgreplier.com\"/><meta property=\"og:site_name\" content=\"MsgReplier\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image\" content=\"https://msgreplier.com/opengraph-image?322e7d028b72311b\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"MsgReplier – Interactive Wishes &amp; Private Couple Spaces\"/><meta name=\"twitter:description\" content=\"Create a magical digital surprise with our wishes website builder or join your partner in a private Love-Space. Simple, fast, and unforgettable.\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image\" content=\"https://msgreplier.com/twitter-image?fafc48916d578aa9\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"shortcut icon\" href=\"/icon.png