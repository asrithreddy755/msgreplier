Tools <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down h-4 w-4\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><a class=\"transition-colors hover:text-[#948678] text-[#110f0f] dark:text-slate-300 dark:hover:text-white font-semibold\" href=\"/digital-greeting/pricing\">Pricing</a><a class=\"transition-colors hover:text-[#948678] text-[#110f0f] dark:text-slate-300 dark:hover:text-white\" href=\"/about\">About</a><a class=\"transition-colors hover:text-[#948678] text-[#110f0f] dark:text-slate-300 dark:hover:text-white\" href=\"/contact\">Contact</a><div class=\"flex items-center gap-2 ml-2\"><a target=\"_blank\" class=\"font-heading font-medium text-xs bg-[#110f0f] text-white hover:bg-[#eedfc6] hover:text-[#110f0f] border border-transparent hover:border-[#d4c3ab] dark:bg-white dark:text-black dark:hover:bg-[#110f0f] dark:hover:text-white px-5 py-2.5 rounded-full transition-all duration-300 uppercase tracking-wider\" href=\"/love-space\">Get Started</a></div></div><div class=\"flex items-center gap-2 md:hidden\"><button class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:text-accent-foreground h-10 w-10 text-[#110f0f] dark:text-white hover:bg-[#eedfc6]/50\" aria-label=\"Toggle Menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></div></header><main id=\"main-content\" class=\"flex-grow\"><!--$--><div class=\"min-h-screen bg-[#f5eedf] text-[#110f0f] antialiased\" style=\"font-family:&quot;Work Sans&quot;, sans-serif\"><style>\n        h1, h2, h3, h4, h5, h6, .font-heading {\n          font-family: 'Unbounded', sans-serif !important;\n        }\n      </style><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Create a Birthday Wishes Website\",\"description\":\"A step-by-step guide to creating a personalised, animated birthday wishes website for someone special.\",\"totalTime\":\"PT5M\",\"step\":[{\"@type\":\"HowToStep\",\"name\":\"Visit the Wishes Website Builder\",\"text\":\"Go to msgreplier.com/digital-greeting and click 'Create Wishes Website'.\"},{\"@type\":\"HowToStep\",\"name\":\"Enter Recipient Details\",\"text\":\"Fill in the recipient's name, your name, and select 'Birthday' as the occasion.\"},{\"@type\":\"HowToStep\",\"name\":\"Write Your Message\",\"text\":\"Type your heartfelt birthday message in the message box.\"},{\"@type\":\"HowToStep\",\"name\":\"Choose a Theme and Music\",\"text\":\"Select from beautiful animated themes and optional background music.\"},{\"@type\":\"HowToStep\",\"name\":\"Share Your Unique Link\",\"text\":\"Copy the generated unique link and send it to your birthday person.\"}],\"url\":\"https://msgreplier.com/blog/birthday-wishes-website-guide\"}</script><div class=\"container max-w-4xl mx-auto px-4 py-8 md:py-12\"><div class=\"mb-8 flex items-center justify-between gap-3\"><a class=\"inline-flex\" href=\"/blog\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-10 px-4 py-2 gap-2 -ml-4 text-[#110f0f] hover:text-[#948678] hover:bg-transparent font-heading font-medium text-xs uppercase tracking-wider\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left h-4 w-4\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Back to Blog</button></a><a class=\"hidden sm:inline-flex\" href=\"/digital-greeting\"><button class=\"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 gap-2\">Create Wishes Website <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div><header class=\"mb-10 md:mb-12\"><div class=\"flex flex-wrap items-center gap-3 text-sm text-muted-foreground mb-4\"><span class=\"flex items-center gap-1 bg-[#eedfc6] border border-[#d4c3ab] text-[#110f0f] px-2.5 py-0.5 rounded-full font-semibold text-xs\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-tag h-3 w-3\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\"></path><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg> Feature Guide</span><span class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-3 w-3\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg> June 1, 2026</span><span class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-3 w-3\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg> 5 min read</span></div><h1 class=\"text-3xl md:text-5xl font-extrabold tracking-tight leading-tight\">Birthday Wishes Website Guide: Create a <span class=\"text-orange-500\">Magical Surprise</span></h1><p class=\"mt-5 text-lg md:text-xl text-muted-foreground leading-relaxed max-w-3xl\">Forget generic birthday texts and boring e-cards. Here&#x27;s how to create a personalised, animated birthday wishes website that will genuinely wow your loved one.</p></header><article class=\"bg-white border border-[#d4c3ab] rounded-[32px] p-6 md:p-10 shadow-sm\"><div class=\"prose prose-neutral dark:prose-invert max-w-none space-y-6\"><h2 class=\"text-2xl font-bold\">Why a Birthday Wishes Website Beats a Regular Message</h2><p>A birthday text disappears into a scroll of notifications. A phone call lasts a minute. But a personalised birthday wishes website? That is something your recipient will open, re-open, and share with friends.</p><p>Unlike static e-cards, a Wishes Website is a fully <strong>interactive, animated webpage</strong> built specifically for your recipient. It plays music, displays 3D animations, and showcases your heartfelt message in a way that genuinely feels magical.</p><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 my-8\"><div class=\"p-4 bg-orange-50 dark:bg-orange-950/20 rounded-xl border border-orange-100 dark:border-orange-900/30 text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gift h-8 w-8 text-orange-500 mx-auto mb-2\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"></rect><path d=\"M12 8v13\"></path><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"></path><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"></path></svg><h4 class=\"font-bold text-sm\">Personalised</h4><p class=\"text-xs text-muted-foreground mt-1\">Their name, your message, your chosen occasion.</p></div><div class=\"p-4 bg-orange-50 dark:bg-orange-950/20 rounded-xl border border-orange-100 dark:border-orange-900/30 text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-music h-8 w-8 text-orange-500 mx-auto mb-2\"><path d=\"M9 18V5l12-2v13\"></path><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><circle cx=\"18\" cy=\"16\" r=\"3\"></circle></svg><h4 class=\"font-bold text-sm\">With Music</h4><p class=\"text-xs text-muted-foreground mt-1\">Add background music to make it extra special.</p></div><div class=\"p-4 bg-orange-50 dark:bg-orange-950/20 rounded-xl border border-orange-100 dark:border-orange-900/30 text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star h-8 w-8 text-orange-500 mx-auto mb-2\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg><h4 class=\"font-bold text-sm\">Unforgettable</h4><p class=\"text-xs text-muted-foreground mt-1\">Beautiful 3D animations they&#x27;ll remember forever.</p></div></div><h2 class=\"text-2xl font-bold mt-8\">How to Create Your Birthday Wishes Website (Step-by-Step)</h2><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">1</div><div><h3 class=\"font-bold text-base mb-1\">Visit the Wishes Website Builder</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Head to our Wishes Website builder page. You will see a simple form — no account or login needed.</p></div></div><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">2</div><div><h3 class=\"font-bold text-base mb-1\">Enter the Recipient&#x27;s Name</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Type the name of the birthday person. This is what will appear on the animated greeting.</p></div></div><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">3</div><div><h3 class=\"font-bold text-base mb-1\">Add Your Name and a Message</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Add your own name so they know who it&#x27;s from, and write a heartfelt birthday message in the text field. Be as personal as you like!</p></div></div><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">4</div><div><h3 class=\"font-bold text-base mb-1\">Choose a Theme</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Select from beautiful themes — each with unique colours, animations, and visual style. Pick the one that best matches their personality.</p></div></div><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">5</div><div><h3 class=\"font-bold text-base mb-1\">Enable Music (Optional)</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Toggle on the music option to add a warm, celebratory background track to your wishes page.</p></div></div><div class=\"flex items-start gap-4 py-4 border-b border-border/30 last:border-0\"><div class=\"w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center shrink-0 text-orange-600 font-black text-lg\">6</div><div><h3 class=\"font-bold text-base mb-1\">Generate and Share Your Link</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Click &#x27;Create&#x27; and your unique birthday wishes website is instantly generated! Copy the link and send it via WhatsApp, Instagram DM, email, or any messaging app.</p></div></div><h2 class=\"text-2xl font-bold mt-10\">Tips for Writing the Perfect Birthday Message</h2><ul class=\"space-y-3 list-none pl-0\"><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-emerald-500 shrink-0 mt-0.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-muted-foreground\">Be specific — mention a memory or quality you love about them.</span></li><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-emerald-500 shrink-0 mt-0.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-muted-foreground\">Keep it warm but authentic — write how you naturally speak.</span></li><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-emerald-500 shrink-0 mt-0.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-muted-foreground\">Add humour if it suits your relationship — a funny inside joke can make the message feel even more personal.</span></li><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-emerald-500 shrink-0 mt-0.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-muted-foreground\">End with a positive, forward-looking statement (e.g., &#x27;Can&#x27;t wait to celebrate together!&#x27;).</span></li><li class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-emerald-500 shrink-0 mt-0.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-muted-foreground\">Avoid generic phrases like &#x27;Have a great day!&#x27; — they feel copy-pasted.</span></li></ul><h2 class=\"text-2xl font-bold mt-10\">Who Is a Wishes Website Perfect For?</h2><p>Our Wishes Website builder works for any relationship and any occasion:</p><ul class=\"list-disc pl-6 space-y-2 text-muted-foreground\"><li><strong class=\"text-foreground\">Partner/Boyfriend/Girlfriend:</strong> Create the most romantic birthday surprise they&#x27;ve ever received.</li><li><strong class=\"text-foreground\">Best Friend:</strong> A personalised wishes site is a massive upgrade from a group chat birthday message.</li><li><strong class=\"text-foreground\">Parents:</strong> Show your parents how much you care with a thoughtful, beautifully animated tribute.</li><li><strong class=\"text-foreground\">Siblings:</strong> Whether you&#x27;re nearby or in a different country, a birthday wishes website bridges the distance.</li></ul><div class=\"mt-12 text-center p-8 bg-orange-50 dark:bg-orange-950/20 rounded-2xl border border-orange-100 dark:border-orange-900/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-gift h-10 w-10 text-orange-500 mx-auto mb-4\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" rx=\"1\"></rect><path d=\"M12 8v13\"></path><path d=\"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7\"></path><path d=\"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5\"></path></svg><h3 class=\"text-xl font-bold mb-3\">Create Your Birthday Wishes Website Now</h3><p class=\"text-muted-foreground mb-6\">Takes less than 2 minutes. No login required. Completely free.</p><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 h-11 rounded-md px-8 bg-orange-500 hover:bg-orange-600 text-white border-0\" href=\"/digital-greeting\">Build Wishes Website <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-2 h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></article></div></div><!--/$--></main><footer class=\"bg-[#110f0f] border-t border-[#d4c3ab]/10 text-white py-16 px-4\" style=\"font-family:&quot;Work Sans&quot;, sans-serif\"><style>\n        .font-heading {\n          font-family: 'Unbounded', sans-serif !important;\n        }\n      </style><div class=\"container mx-auto max-w-6xl\"><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16 items-start\"><div class=\"space-y-6 flex flex-col items-start text-left\"><a class=\"flex items-center gap-2 font-heading font-bold text-lg md:text-xl tracking-tight text-white select-none\" href=\"/\"><div class=\"bg-white text-black p-1.5 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square h-5 w-5\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg></div><span>MsgReplier</span></a><p class=\"text-sm text-[#d4c3ab]/80 leading-relaxed max-w-xs\">Crafting the ultimate digital tools for couples — including the private <strong>Love-Space</strong> and interactive <strong>Wishes Website</strong> builder.</p><p class=\"text-xs text-[#d4c3ab]/60\">Made with ❤️ in India</p><a class=\"font-heading font-medium text-xs bg-white text-black hover:bg-[#eedfc6] px-5 py-3 rounded-full transition-all duration-300 uppercase tracking-wider block\" href=\"/love-space\">Get Started</a></div><div class=\"space-y-4 text-left\"><h4 class=\"font-heading text-xs font-bold uppercase tracking-wider text-[#eedfc6] mb-6\">Our Tools</h4><ul class=\"space-y-3 text-sm\"><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/love-space\">Love Space</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/digital-greeting\">Wishes Website</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/flames\">FLAMES Calculator</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/prompt\">AI Couple Prompts</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/blog\">Blog &amp; Guides</a></li></ul></div><div class=\"space-y-4 text-left\"><h4 class=\"font-heading text-xs font-bold uppercase tracking-wider text-[#eedfc6] mb-6\">Company</h4><ul class=\"space-y-3 text-sm\"><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/about\">About Us</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/contact\">Contact Us</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/faq\">FAQ</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/community-guidelines\">Community Guidelines</a></li><li><a class=\"text-slate-300 hover:text-white transition-colors\" href=\"/sitemap.xml\">Sitemap</a></li></ul></div><div class=\"space-y-4 text-left\"><h4 class=\"font-heading text-xs font-bold uppercase tracking-wider text-[#eedfc6] mb-6\">Connect</h4><ul class=\"space-y-3 text-sm\"><li><a href=\"mailto:care.msgreplier@gmail.com\" class=\"text-slate-300 hover:text-white transition-colors\">📧 Email Support</a></li><li><a href=\"https://www.instagram.com/msgreplier?igsh=YWM1YnptbzNncXg4\" class=\"text-slate-300 hover:text-white transition-colors\" target=\"_blank\" rel=\"noreferrer\">📷 Instagram</a></li><li><a href=\"https://youtube.com/@msgreplier?si=J8Wg9x6tOFuQGP9-\" class=\"text-slate-300 hover:text-white transition-colors\" target=\"_blank\" rel=\"noreferrer\">▶️ YouTube</a></li></ul></div></div><div class=\"pt-8 border-t border-[#d4c3ab]/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400\"><p>© <!-- -->2026<!-- --> MsgReplier. Handcrafted with love. All rights reserved.</p><div class=\"flex flex-wrap justify-center gap-4\"><a class=\"hover:text-white transition-colors\" href=\"/privacy-policy\">Privacy Policy</a><a class=\"hover:text-white transition-colors\" href=\"/terms-conditions\">Terms of Service</a><a class=\"hover:text-white transition-colors\" href=\"/cookie-policy\">Cookie Policy</a><a class=\"hover:text-white transition-colors\" href=\"/community-guidelines\">Community Guidelines</a></div></div></div></footer></div><div role=\"region\" aria-label=\"Notifications (F8)\" tabindex=\"-1\" style=\"pointer-events:none\"><ol tabindex=\"-1\" class=\"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]\"></ol></div><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\"></section><script src=\"/_next/static/chunks/webpack-95cc16016cdfb96f.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n3:I[87555,[],\\\"\\\"]\\n4:I[31295,[],\\\"\\\"]\\n5:I[6874,[\\\"6874\\\",\\\"static/chunks/6874-43684eac73d02ae4.js\\\",\\\"7350\\\",\\\"static/chunks/app/bl