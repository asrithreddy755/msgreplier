{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"4294967294","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/relationship-communication-tips/layout,_N_T_/blog/relationship-communication-tips/page,_N_T_/blog/relationship-communication-tips"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\"/><link rel=\"stylesheet\" href=\"/_next/static/css/76eb9e93ac3d3a04.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-95cc16016cdfb96f.js\"/><script src=\"/_next/static/chunks/4bd1b696-c9306982bc4992b6.js\" async=\"\"></script><script src=\"/_next/static/chunks/1684-187bd4b12caf3732.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-1d2908b81aa28bd8.js\" async=\"\"></script><script src=\"/_next/static/chunks/6874-43684eac73d02ae4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/relationship-communication-tips/page-0ec85ae62d16ee9d.js\" async=\"\"></script><script src=\"/_next/static/chunks/668-3c9728cc03492410.js\" async=\"\"></script><script src=\"/_next/static/chunks/6671-a156e624aef6ad97.js\" async=\"\"></script><script src=\"/_next/static/chunks/8966-fe9c0b7581b40f7f.js\" async=\"\"></script><script src=\"/_next/static/chunks/8660-9547e3bd32179869.js\" async=\"\"></script><script src=\"/_next/static/chunks/7665-faac800d6f299277.js\" async=\"\"></script><script src=\"/_next/static/chunks/2323-91a8cccc686e3a27.js\" async=\"\"></script><script src=\"/_next/static/chunks/2707-553210aacc5228b8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-bf4362c50304bbf4.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-1XPYWEPPGJ\" as=\"script\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" hre