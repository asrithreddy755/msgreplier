",\"x2\":\"9.01\",\"y1\":\"9\",\"y2\":\"9\"}],[\"$\",\"line\",\"1p4y9e\",{\"x1\":\"15\",\"x2\":\"15.01\",\"y1\":\"9\",\"y2\":\"9\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground text-sm\",\"children\":\"Add a light-hearted observation about your morning that brings them into your world.\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-sun h-5 w-5 text-orange-500 shrink-0 mt-0.5\",\"children\":[[\"$\",\"circle\",\"4exip2\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"4\"}],[\"$\",\"path\",\"tus03m\",{\"d\":\"M12 2v2\"}],[\"$\",\"path\",\"1lh1kg\",{\"d\":\"M12 20v2\"}],[\"$\",\"path\",\"149t6j\",{\"d\":\"m4.93 4.93 1.41 1.41\"}],[\"$\",\"path\",\"ptbguv\",{\"d\":\"m17.66 17.66 1.41 1.41\"}],[\"$\",\"path\",\"1t8f8n\",{\"d\":\"M2 12h2\"}],[\"$\",\"path\",\"1q8mjw\",{\"d\":\"M20 12h2\"}],[\"$\",\"path\",\"1m8zz5\",{\"d\":\"m6.34 17.66-1.41 1.41\"}],[\"$\",\"path\",\"1shlcs\",{\"d\":\"m19.07 4.93-1.41 1.41\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground text-sm\",\"children\":\"End with something forward-looking — a plan to call, a countdown to seeing them, or a wish for their day.\"}]]}]]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mt-10\",\"children\":\"Connect in Real Time with Love-Space\"}],[\"$\",\"p\",null,{\"children\":[\"A good morning text is a beautiful start, but sometimes you want more than a message. If you want to truly feel close — even from a distance — try\",\" \",[\"$\",\"$L5\",null,{\"href\":\"/love-space\",\"className\":\"text-primary hover:underline\",\"children\":\"Love-Space\"}],\": a private, real-time digital room where you can chat and play games together w